{
  "source": "https://www.shidianguji.com/book/HY2666/chapter/1kw4juo9tsfty",
  "volume": "說文廣義卷之二",
  "entries": [
    {
      "headword": "齊",
      "gloss": "六十部禾麥吐穗上平也象形凡亝之屬皆从亝徐鍇曰生而齊者莫若禾麥二地也兩傍在低",
      "headword_line_id": 188,
      "gloss_line_id": 189
    },
    {
      "headword": "齏",
      "gloss": "等也从齊妻聲徂兮切",
      "headword_line_id": 193,
      "gloss_line_id": 194
    },
    {
      "headword": "西",
      "gloss": "六十一部烏在巢上象形日在西方而烏棲故因以爲東西之西凡西之屬皆从西先稽切",
      "headword_line_id": 196,
      "gloss_line_id": 197
    },
    {
      "headword": "䙵",
      "gloss": "姓也从西圭聲戸圭切",
      "headword_line_id": 199,
      "gloss_line_id": 200
    },
    {
      "headword": "禾",
      "gloss": "六十二部木之曲頭止不能上也凡禾之屬皆从禾古兮切",
      "headword_line_id": 202,
      "gloss_line_id": 203
    },
    {
      "headword": "積",
      "gloss": "多小意而止也从禾从只聲一日木也職雉切",
      "headword_line_id": 205,
      "gloss_line_id": 206
    },
    {
      "headword": "称",
      "gloss": "積䅓也以禾从又句聲又者从丑省一日木名徐錯日丑者朿縛也積䅓不伸之意俱羽切",
      "headword_line_id": 208,
      "gloss_line_id": 209
    },
    {
      "headword": "稽",
      "gloss": "六十三部留止也从禾从尤旨聲凡稽之屬皆从稽古兮切",
      "headword_line_id": 211,
      "gloss_line_id": 212
    },
    {
      "headword": "穃",
      "gloss": "稽称而止也从稽省咎聲讀若皓賈侍中說稽稽穃三字皆木名古老切",
      "headword_line_id": 214,
      "gloss_line_id": 215
    },
    {
      "headword": "稽",
      "gloss": "特止也从稽省卓聲徐錯曰特止卓立也竹角切",
      "headword_line_id": 217,
      "gloss_line_id": 218
    },
    {
      "headword": "兮",
      "gloss": "六十四部語所稽也从工八象今越云也凡兮之屬皆从兮胡雞切",
      "headword_line_id": 220,
      "gloss_line_id": 221
    },
    {
      "headword": "羲",
      "gloss": "气也从兮義聲許羈切",
      "headword_line_id": 224,
      "gloss_line_id": 225
    },
    {
      "headword": "乎",
      "gloss": "語之餘也从𠔃象聲上越揚之形也戸吳切",
      "headword_line_id": 227,
      "gloss_line_id": 228
    },
    {
      "headword": "𠣬",
      "gloss": "驚辭也从兮旬聲思允切",
      "headword_line_id": 230,
      "gloss_line_id": 231
    },
    {
      "headword": "乖",
      "gloss": "六十五部背呂也象脅肋形凡垂之屬皆从乖古懷切",
      "headword_line_id": 233,
      "gloss_line_id": 234
    },
    {
      "headword": "脔",
      "gloss": "背呂也从垂从肉資昔切",
      "headword_line_id": 236,
      "gloss_line_id": 237
    },
    {
      "headword": "嵬",
      "gloss": "六千六部高不平也从山鬼聲凡嵬之屬皆从嵬五灰切",
      "headword_line_id": 239,
      "gloss_line_id": 240
    },
    {
      "headword": "巍",
      "gloss": "高也从嵬委聲牛威切臣鉉等曰今人省山以爲魏國之魏語韋切",
      "headword_line_id": 242,
      "gloss_line_id": 243
    },
    {
      "headword": "巍",
      "gloss": "魏山思亾來胜",
      "headword_line_id": 242,
      "gloss_line_id": 244
    },
    {
      "headword": "白",
      "gloss": "六十七部小自也象形凡白之屬皆从𠂤臣鉉等曰亼俗作堆都回切",
      "headword_line_id": 246,
      "gloss_line_id": 247
    },
    {
      "headword": "官",
      "gloss": "吏事君也从一从𠂤𠂤猶衆也此與師同意古丸切",
      "headword_line_id": 249,
      "gloss_line_id": 250
    },
    {
      "headword": "官",
      "gloss": "危高也从白屮聲讀若臬魚列切",
      "headword_line_id": 253,
      "gloss_line_id": 254
    },
    {
      "headword": "來",
      "gloss": "六十八部周所受瑞麥來麰一來二縫象芒束之形天所來也故爲行來之來詩曰詒我來麰凡",
      "headword_line_id": 256,
      "gloss_line_id": 257
    },
    {
      "headword": "娭",
      "gloss": "詩曰不𥏳不來从來矣聲牀史切",
      "headword_line_id": 261,
      "gloss_line_id": 262
    },
    {
      "headword": "才",
      "gloss": "六十九部艸木之初也从丨上貫一將生枝葉一地也凡才之屬皆从才徐鍇曰上一初生岐枝",
      "headword_line_id": 264,
      "gloss_line_id": 265
    },
    {
      "headword": "才",
      "gloss": "也下一地也昨哉切",
      "headword_line_id": 264,
      "gloss_line_id": 266
    },
    {
      "headword": "申",
      "gloss": "七十部神也七月陰气成體自申束从臼白持也吏吕餔時聽事中曰政也凡申之屬皆从申失",
      "headword_line_id": 269,
      "gloss_line_id": 270
    },
    {
      "headword": "㐕",
      "gloss": "朿縛薩抴爲臾从申从乙臣鉉等曰乙屈也羊朱切",
      "headword_line_id": 274,
      "gloss_line_id": 275
    },
    {
      "headword": "曳",
      "gloss": "曳曵也从申丿聲余制切",
      "headword_line_id": 277,
      "gloss_line_id": 278
    },
    {
      "headword": "輔",
      "gloss": "擊小鼓引樂聲也从申柬聲羊晉切",
      "headword_line_id": 280,
      "gloss_line_id": 281
    },
    {
      "headword": "身",
      "gloss": "七十部躬也象人之身从人丁聲凡身之屬皆从身失人切",
      "headword_line_id": 283,
      "gloss_line_id": 284
    },
    {
      "headword": "軀",
      "gloss": "體也从身區聲豈俱切",
      "headword_line_id": 286,
      "gloss_line_id": 287
    },
    {
      "headword": "辰",
      "gloss": "七十二部震也三月陽气動靁電振民農時也物皆生从乙七象芒達丁聲也辰房星天時也从",
      "headword_line_id": 289,
      "gloss_line_id": 290
    },
    {
      "headword": "二二古文上字凡辰之屬皆从辰徐錯曰七音化",
      "gloss": "乙草木萌初出曲卷也臣鉉等曰三月陽气盛草木生上徹于士故从上丁非",
      "headword_line_id": 291,
      "gloss_line_id": 292
    },
    {
      "headword": "辱",
      "gloss": "恥也从寸在辰下失耕時于封畺上戮之也辰者農之時也故房星爲辰田候也而蜀切",
      "headword_line_id": 296,
      "gloss_line_id": 297
    },
    {
      "headword": "晨",
      "gloss": "七十三部早昧爽也从臼从辰辰時也辰亦聲風夕爲𡖊臼辰爲晨皆同意凡晨之屬皆从晨食",
      "headword_line_id": 299,
      "gloss_line_id": 300
    },
    {
      "headword": "農",
      "gloss": "耕也从晨囟聲徐鍇曰當从凶乃得聲奴夂切",
      "headword_line_id": 304,
      "gloss_line_id": 305
    },
    {
      "headword": "臣",
      "gloss": "七十四部牽也事君也象屈服之形凡臣之屬皆从臣植鄰切",
      "headword_line_id": 307,
      "gloss_line_id": 308
    },
    {
      "headword": "臧",
      "gloss": "善也从臣戕聲則郞切",
      "headword_line_id": 311,
      "gloss_line_id": 312
    },
    {
      "headword": "臦",
      "gloss": "垂也从二臣相違讀若誑居况切",
      "headword_line_id": 314,
      "gloss_line_id": 315
    },
    {
      "headword": "人",
      "gloss": "七十五部天地之性最貴者也此籀文象臂脛之形凡人之屬皆从人如鄰切",
      "headword_line_id": 317,
      "gloss_line_id": 318
    },
    {
      "headword": "俑",
      "gloss": "痛也从人𭺸聲他紅切又余隴切",
      "headword_line_id": 320,
      "gloss_line_id": 321
    },
    {
      "headword": "侗",
      "gloss": "大皃从人同聲詩日神罔時侗他紅切",
      "headword_line_id": 323,
      "gloss_line_id": 324
    },
    {
      "headword": "僮",
      "gloss": "未冠也从人童聲徒紅切",
      "headword_line_id": 326,
      "gloss_line_id": 327
    },
    {
      "headword": "仜",
      "gloss": "大腹也从人工聲讀若紅戸工切",
      "headword_line_id": 329,
      "gloss_line_id": 330
    },
    {
      "headword": "公",
      "gloss": "志及衆也从人公聲職茸切",
      "headword_line_id": 332,
      "gloss_line_id": 333
    },
    {
      "headword": "傭",
      "gloss": "均直也从人庸聲余封切",
      "headword_line_id": 335,
      "gloss_line_id": 336
    },
    {
      "headword": "供",
      "gloss": "設也从人共聲一曰供給俱容切",
      "headword_line_id": 339,
      "gloss_line_id": 340
    },
    {
      "headword": "儷",
      "gloss": "棽儷也从人麗聲三支切",
      "headword_line_id": 342,
      "gloss_line_id": 343
    },
    {
      "headword": "儀",
      "gloss": "度也从人義聲魚羈切",
      "headword_line_id": 345,
      "gloss_line_id": 346
    },
    {
      "headword": "倭",
      "gloss": "順皃从人委聲詩曰周道倭遟干爲切",
      "headword_line_id": 348,
      "gloss_line_id": 349
    },
    {
      "headword": "倠",
      "gloss": "仳倠醜面𬽡人佳聲許惟切",
      "headword_line_id": 351,
      "gloss_line_id": 352
    },
    {
      "headword": "伊",
      "gloss": "殷聖人阿衡尹治天下者从人从尹於脂切",
      "headword_line_id": 354,
      "gloss_line_id": 355
    },
    {
      "headword": "伾",
      "gloss": "有力也从人不聲詩日以車伾伾敷悲切",
      "headword_line_id": 357,
      "gloss_line_id": 358
    },
    {
      "headword": "仔",
      "gloss": "克也从人子聲子之切",
      "headword_line_id": 360,
      "gloss_line_id": 361
    },
    {
      "headword": "僖",
      "gloss": "樂也从人喜聲許其切",
      "headword_line_id": 363,
      "gloss_line_id": 364
    },
    {
      "headword": "僛",
      "gloss": "醉舞皃从人欺聲詩日屢舞僛僛去其切",
      "headword_line_id": 367,
      "gloss_line_id": 368
    },
    {
      "headword": "敱",
      "gloss": "妙也从人从支豈省聲臣鉉等案豈字从敳省敳不應从豈省葢𫝊寫之誤疑从耑省喘物初生之",
      "headword_line_id": 370,
      "gloss_line_id": 371
    },
    {
      "headword": "敱",
      "gloss": "題尙敳也無非也",
      "headword_line_id": 370,
      "gloss_line_id": 372
    },
    {
      "headword": "依",
      "gloss": "倚也从人衣聲茅稀切",
      "headword_line_id": 374,
      "gloss_line_id": 375
    },
    {
      "headword": "僟",
      "gloss": "精謹也从人幾聲明堂月令歲將機終耳衣切",
      "headword_line_id": 377,
      "gloss_line_id": 378
    },
    {
      "headword": "徐",
      "gloss": "緩也从人余聲似余切",
      "headword_line_id": 380,
      "gloss_line_id": 381
    },
    {
      "headword": "伹",
      "gloss": "拙也从人且聲似魚切",
      "headword_line_id": 383,
      "gloss_line_id": 384
    },
    {
      "headword": "儲",
      "gloss": "偫也从人諸聲植魚切",
      "headword_line_id": 386,
      "gloss_line_id": 387
    },
    {
      "headword": "伃",
      "gloss": "婦官也从人予聲以諸切",
      "headword_line_id": 389,
      "gloss_line_id": 390
    },
    {
      "headword": "俱",
      "gloss": "偕也从人具聲舉朱切",
      "headword_line_id": 392,
      "gloss_line_id": 393
    },
    {
      "headword": "俘",
      "gloss": "軍所獲也从人孚聲春秋傳日以爲俘聝芳無切",
      "headword_line_id": 397,
      "gloss_line_id": 398
    },
    {
      "headword": "儒",
      "gloss": "柔也術士之稱从人埀聲人朱切",
      "headword_line_id": 400,
      "gloss_line_id": 401
    },
    {
      "headword": "低",
      "gloss": "下也从人氐氐亦聲都兮切",
      "headword_line_id": 403,
      "gloss_line_id": 404
    },
    {
      "headword": "倪",
      "gloss": "俾也从人兒聲五雞切",
      "headword_line_id": 406,
      "gloss_line_id": 407
    },
    {
      "headword": "佳",
      "gloss": "善也从人圭聲古膎切",
      "headword_line_id": 409,
      "gloss_line_id": 410
    },
    {
      "headword": "偕",
      "gloss": "彊也从人皆聲詩日偕偕士子一曰俱也古諧切",
      "headword_line_id": 412,
      "gloss_line_id": 413
    },
    {
      "headword": "俙",
      "gloss": "訟面相是从人希聲喜皆切",
      "headword_line_id": 415,
      "gloss_line_id": 416
    },
    {
      "headword": "儕",
      "gloss": "等輩也从人齊聲春秋傳日吾儕小人仕皆切",
      "headword_line_id": 418,
      "gloss_line_id": 419
    },
    {
      "headword": "俳",
      "gloss": "戲也从人非聲步皆切",
      "headword_line_id": 421,
      "gloss_line_id": 422
    },
    {
      "headword": "傀",
      "gloss": "偉也从人鬼聲周禮曰大傀異公回切",
      "headword_line_id": 424,
      "gloss_line_id": 425
    },
    {
      "headword": "儡",
      "gloss": "相敗也从人畾聲讀若雷魯回切",
      "headword_line_id": 427,
      "gloss_line_id": 428
    },
    {
      "headword": "催",
      "gloss": "相擣也从人崔聲詩曰室人交徧催我倉回切",
      "headword_line_id": 430,
      "gloss_line_id": 431
    },
    {
      "headword": "侅",
      "gloss": "奇侅非常也从人亥聲士哀切",
      "headword_line_id": 433,
      "gloss_line_id": 434
    },
    {
      "headword": "偲",
      "gloss": "彊力也从人思聲詩日其人美且偲倉才切",
      "headword_line_id": 436,
      "gloss_line_id": 437
    },
    {
      "headword": "身",
      "gloss": "神也从人身聲失人切",
      "headword_line_id": 439,
      "gloss_line_id": 440
    },
    {
      "headword": "伸",
      "gloss": "屈伸从人申聲失人切",
      "headword_line_id": 442,
      "gloss_line_id": 443
    },
    {
      "headword": "仁",
      "gloss": "親也从人从二臣鉉等日仁者兼愛故从二如鄰切",
      "headword_line_id": 445,
      "gloss_line_id": 446
    },
    {
      "headword": "份",
      "gloss": "文質備也从人分聲論語日文質份份府巾切",
      "headword_line_id": 448,
      "gloss_line_id": 449
    },
    {
      "headword": "倫",
      "gloss": "輩也从人侖聲三曰道也力屯切",
      "headword_line_id": 451,
      "gloss_line_id": 452
    },
    {
      "headword": "侁",
      "gloss": "行皃从人先聲所臻切",
      "headword_line_id": 454,
      "gloss_line_id": 455
    },
    {
      "headword": "㑮",
      "gloss": "人姓从人軍聲吾昆切",
      "headword_line_id": 457,
      "gloss_line_id": 458
    },
    {
      "headword": "侒",
      "gloss": "宴也从人安聲烏寒切",
      "headword_line_id": 460,
      "gloss_line_id": 461
    },
    {
      "headword": "儃",
      "gloss": "儃何也从人亶聲徒千切",
      "headword_line_id": 463,
      "gloss_line_id": 464
    },
    {
      "headword": "仚",
      "gloss": "人在山上从人从山呼堅切",
      "headword_line_id": 466,
      "gloss_line_id": 467
    },
    {
      "headword": "位",
      "gloss": "狠也从人弦省聲胡田切",
      "headword_line_id": 469,
      "gloss_line_id": 470
    },
    {
      "headword": "僊",
      "gloss": "長生僊去从人从𢙣䙴亦聲相然切",
      "headword_line_id": 472,
      "gloss_line_id": 473
    },
    {
      "headword": "便",
      "gloss": "安也人有不便更之从人更房連切",
      "headword_line_id": 475,
      "gloss_line_id": 476
    },
    {
      "headword": "偏",
      "gloss": "頗也从人扁聲芳連切",
      "headword_line_id": 478,
      "gloss_line_id": 479
    },
    {
      "headword": "佺",
      "gloss": "偓佺仙人也从人全聲此緣切",
      "headword_line_id": 481,
      "gloss_line_id": 482
    },
    {
      "headword": "儇",
      "gloss": "慧也从人睘聲許緣切",
      "headword_line_id": 484,
      "gloss_line_id": 485
    },
    {
      "headword": "佻",
      "gloss": "愉也从𠆧兆聲詩曰視民不佻土彫切",
      "headword_line_id": 487,
      "gloss_line_id": 488
    },
    {
      "headword": "僥",
      "gloss": "南方有焦僥人長三尺短之極从人堯聲五聊切",
      "headword_line_id": 490,
      "gloss_line_id": 491
    },
    {
      "headword": "儦",
      "gloss": "行皃从人麃聲詩日行人儦儦甫嬌切",
      "headword_line_id": 493,
      "gloss_line_id": 494
    },
    {
      "headword": "佋",
      "gloss": "廟佲穆父爲佋南面子爲穆北面从人召聲市招切",
      "headword_line_id": 496,
      "gloss_line_id": 497
    },
    {
      "headword": "㑾",
      "gloss": "喜也从人多聲自關以西物大小不同謂之㑾余招切",
      "headword_line_id": 499,
      "gloss_line_id": 500
    },
    {
      "headword": "僑",
      "gloss": "高也从人喬聲巨嬌切",
      "headword_line_id": 502,
      "gloss_line_id": 503
    },
    {
      "headword": "倄",
      "gloss": "刺也从人肴聲一曰痛聲胡茅切",
      "headword_line_id": 505,
      "gloss_line_id": 506
    },
    {
      "headword": "𠋺",
      "gloss": "俻驕也从人蚤聲穌遭切",
      "headword_line_id": 508,
      "gloss_line_id": 509
    },
    {
      "headword": "喝安",
      "gloss": "以宏",
      "headword_line_id": 510,
      "gloss_line_id": 511
    },
    {
      "headword": "傮",
      "gloss": "終也从人曹聲作曹切",
      "headword_line_id": 513,
      "gloss_line_id": 514
    },
    {
      "headword": "何",
      "gloss": "儋也从人可聲臣鉉等曰儋何卽負何也借爲誰何之何厶俗別作擔荷非是胡歌切",
      "headword_line_id": 516,
      "gloss_line_id": 517
    },
    {
      "headword": "俄",
      "gloss": "行頃也从人我聲詩日仄弁之俄五何切",
      "headword_line_id": 519,
      "gloss_line_id": 520
    },
    {
      "headword": "傞",
      "gloss": "醉舞皃从人差聲詩日屢舞傞傞素何切",
      "headword_line_id": 522,
      "gloss_line_id": 523
    },
    {
      "headword": "佗",
      "gloss": "負何也从人它聲臣鉉等曰史記匃奴奇畜有橐佗今俗譌誤謂之駱駝非是徒何切",
      "headword_line_id": 525,
      "gloss_line_id": 526
    },
    {
      "headword": "儺",
      "gloss": "行有節也从人難聲詩日佩王之儺諾何切",
      "headword_line_id": 528,
      "gloss_line_id": 529
    },
    {
      "headword": "侉",
      "gloss": "僃詞从人夸聲苦瓜切",
      "headword_line_id": 531,
      "gloss_line_id": 532
    },
    {
      "headword": "傷",
      "gloss": "創也从人塲省聲式羊切",
      "headword_line_id": 534,
      "gloss_line_id": 535
    },
    {
      "headword": "償",
      "gloss": "還也从人賞聲食章切",
      "headword_line_id": 537,
      "gloss_line_id": 538
    },
    {
      "headword": "倀",
      "gloss": "狂也从人長聲一日仆也楮羊切",
      "headword_line_id": 540,
      "gloss_line_id": 541
    },
    {
      "headword": "僵",
      "gloss": "僨也从人畺聲居良切",
      "headword_line_id": 543,
      "gloss_line_id": 544
    },
    {
      "headword": "傍",
      "gloss": "近也从人旁聲步光切",
      "headword_line_id": 547,
      "gloss_line_id": 548
    },
    {
      "headword": "恍",
      "gloss": "小兒从人光聲春秋國語日侊飯不及一食古橫切",
      "headword_line_id": 550,
      "gloss_line_id": 551
    },
    {
      "headword": "傾",
      "gloss": "仄也从人从頃頃亦聲去營切",
      "headword_line_id": 553,
      "gloss_line_id": 554
    },
    {
      "headword": "俜",
      "gloss": "使也从人甹聲普丁切",
      "headword_line_id": 556,
      "gloss_line_id": 557
    },
    {
      "headword": "停",
      "gloss": "止也从人亭聲特丁切",
      "headword_line_id": 559,
      "gloss_line_id": 560
    },
    {
      "headword": "伶",
      "gloss": "弄也从人令聲益州有建伶縣郎丁切",
      "headword_line_id": 562,
      "gloss_line_id": 563
    },
    {
      "headword": "偁",
      "gloss": "揚也从人爯聲處陵切",
      "headword_line_id": 565,
      "gloss_line_id": 566
    },
    {
      "headword": "偁",
      "gloss": "冉二",
      "headword_line_id": 565,
      "gloss_line_id": 567
    }
  ]
}
